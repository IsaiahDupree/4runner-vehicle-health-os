    {
      "name": "center_vent_temperature",
      "unit": "Cel",
      "maximum_age_ms": 0,
      "accepted_quality": ["GOOD"]
    }
  ],
  "constants": [],
  "output": {"unit": "Cel", "truth_boundary": "ESTIMATED"},
  "confidence_model": {
    "equation_id": "ac.confidence.evidence",
    "version": "1.0.0",
    "factors": ["SOURCE_QUALITY", "CALIBRATION_QUALITY"]
  },
  "applicability": {
