{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vhos.dev/v1/transport-link-reliability-matrix.schema.json",
  "title": "VHOS offline transport link reliability matrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "contract_version",
    "corpus_id",
    "source_classification",
    "required_display_label",
    "scenario_count",
    "soak_cycles",
    "total_wire_deliveries",
    "total_accepted_unique_records",
    "healthy_scenarios",
    "degraded_scenarios",
    "acceptance_status",
    "scenarios",
    "budgets",
    "authority"
  ],
  "properties": {
    "contract": {"const": "transport.link-reliability-matrix"},
    "contract_version": {"const": "1.0.0"},
    "corpus_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "source_classification": {"const": "REAL_CAPTURE_REPLAY"},
    "required_display_label": {"const": "HISTORICAL REPLAY • NOT LIVE"},
    "scenario_count": {"const": 15},
    "soak_cycles": {"type": "integer", "minimum": 1, "maximum": 1000},
    "total_wire_deliveries": {"type": "integer", "minimum": 1},
    "total_accepted_unique_records": {"type": "integer", "minimum": 1},
    "healthy_scenarios": {"type": "integer", "minimum": 0, "maximum": 15},
    "degraded_scenarios": {"type": "integer", "minimum": 0, "maximum": 15},
    "acceptance_status": {"$ref": "#/$defs/acceptanceStatus"},
    "scenarios": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {"$ref": "#/$defs/scenario"}
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_decoder_buffer_bytes",
        "connection_supervision_milliseconds",
        "clean_unexpected_loss",
        "clean_duplicates_accepted",
        "clean_stale_epochs_accepted",
        "recovery_boundary"
      ],
      "properties": {
        "maximum_decoder_buffer_bytes": {"type": "integer", "minimum": 1},
        "connection_supervision_milliseconds": {"type": "integer", "minimum": 1},
        "clean_unexpected_loss": {"const": 0},
        "clean_duplicates_accepted": {"const": 0},
        "clean_stale_epochs_accepted": {"const": 0},
        "recovery_boundary": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "authority": {"type": "string", "minLength": 1, "maxLength": 1000}
  },
  "$defs": {
    "quality": {"enum": ["HEALTHY", "DEGRADED"]},
    "acceptanceStatus": {"enum": ["PASS", "FAIL"]},
    "counter": {"type": "integer", "minimum": 0},
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "impairment",
        "expected_quality",
        "observed_quality",
        "cycles",
        "wire_deliveries",
        "unique_input_records",
        "expected_unique_records",
        "accepted_unique_records",
        "induced_lost_wire_frames",
        "injected_duplicate_frames",
        "injected_duplicate_notifications",
        "injected_stale_notifications",
        "duplicate_identity_rejections",
        "stale_epoch_notification_rejections",
        "outer_sequence_regression_rejections",
        "outer_sequence_gaps",
        "reconnects",
        "short_stalls",
        "maximum_stall_milliseconds",
        "notification_fragments",
        "decoded_wire_frames",
        "decoder_recoveries",
        "decoder_corrupt_candidates",
        "decoder_discarded_bytes",
        "decoder_buffered_bytes",
        "decoder_maximum_buffer_bytes",
        "exact_expected_survivor_order_and_payload",
        "acceptance_status"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 100},
        "impairment": {"type": "string", "minLength": 1, "maxLength": 100},
        "expected_quality": {"$ref": "#/$defs/quality"},
        "observed_quality": {"$ref": "#/$defs/quality"},
        "cycles": {"type": "integer", "minimum": 1, "maximum": 1000},
        "wire_deliveries": {"$ref": "#/$defs/counter"},
        "unique_input_records": {"$ref": "#/$defs/counter"},
        "expected_unique_records": {"$ref": "#/$defs/counter"},
        "accepted_unique_records": {"$ref": "#/$defs/counter"},
        "induced_lost_wire_frames": {"$ref": "#/$defs/counter"},
        "injected_duplicate_frames": {"$ref": "#/$defs/counter"},
        "injected_duplicate_notifications": {"$ref": "#/$defs/counter"},
        "injected_stale_notifications": {"$ref": "#/$defs/counter"},
        "duplicate_identity_rejections": {"$ref": "#/$defs/counter"},
        "stale_epoch_notification_rejections": {"$ref": "#/$defs/counter"},
        "outer_sequence_regression_rejections": {"$ref": "#/$defs/counter"},
        "outer_sequence_gaps": {"$ref": "#/$defs/counter"},
        "reconnects": {"$ref": "#/$defs/counter"},
        "short_stalls": {"$ref": "#/$defs/counter"},
        "maximum_stall_milliseconds": {"$ref": "#/$defs/counter"},
        "notification_fragments": {"$ref": "#/$defs/counter"},
        "decoded_wire_frames": {"$ref": "#/$defs/counter"},
        "decoder_recoveries": {"$ref": "#/$defs/counter"},
        "decoder_corrupt_candidates": {"$ref": "#/$defs/counter"},
        "decoder_discarded_bytes": {"$ref": "#/$defs/counter"},
        "decoder_buffered_bytes": {"$ref": "#/$defs/counter"},
        "decoder_maximum_buffer_bytes": {"$ref": "#/$defs/counter"},
        "exact_expected_survivor_order_and_payload": {"type": "boolean"},
        "acceptance_status": {"$ref": "#/$defs/acceptanceStatus"}
      }
    }
  }
}
