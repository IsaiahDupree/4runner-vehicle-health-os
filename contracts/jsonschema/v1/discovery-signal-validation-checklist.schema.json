{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vhos.dev/v1/discovery-signal-validation-checklist.schema.json",
  "title": "VHOS Discovery signal validation checklist v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "contract_version", "candidate_id", "evaluated_at", "items", "authority"],
  "properties": {
    "contract": {"const": "vhos.discovery.signal-validation-checklist"},
    "contract_version": {"const": "1.0.0"},
    "candidate_id": {"type": "string", "pattern": "^candidate_[0-9A-HJKMNP-TV-Z]{26}$"},
    "evaluated_at": {"$ref": "common.schema.json#/$defs/wallTime"},
    "items": {"type": "array", "minItems": 1, "maxItems": 17, "items": {"$ref": "discovery-common.schema.json#/$defs/validationItem"}},
    "approval": {"$ref": "discovery-common.schema.json#/$defs/approval"},
    "authority": {"const": "EXPERIMENTAL_CANDIDATE"}
  }
}
