{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vhos.dev/v1/maintenance-requirement.schema.json",
  "title": "VHOS versioned maintenance requirement v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "contract_version", "requirement_id", "requirement_key", "requirement_version",
    "vehicle_pack_id", "vehicle_pack_version", "source_manifest_sha256", "authority",
    "task", "rule", "applicability", "source_locators"
  ],
  "properties": {
    "contract": {"const": "vehicle.maintenance-requirement"},
    "contract_version": {"const": "1.0.0"},
    "requirement_id": {"$ref": "vehicle-lifecycle-common.schema.json#/$defs/requirementId"},
    "requirement_key": {"$ref": "vehicle-lifecycle-common.schema.json#/$defs/canonicalKey"},
    "requirement_version": {"$ref": "common.schema.json#/$defs/semanticVersion"},
    "vehicle_pack_id": {"$ref": "vehicle-lifecycle-common.schema.json#/$defs/canonicalKey"},
    "vehicle_pack_version": {"$ref": "common.schema.json#/$defs/semanticVersion"},
    "source_manifest_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "authority": {"enum": ["DRAFT", "REVIEWED", "ACTIVE", "RETIRED"]},
    "task": {"$ref": "#/$defs/task"},
    "rule": {"$ref": "#/$defs/rule"},
    "applicability": {"$ref": "#/$defs/applicability"},
    "source_locators": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "vehicle-lifecycle-common.schema.json#/$defs/sourceLocator"}}
  },
  "$defs": {
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "task_key", "action", "title", "system", "component_key"],
      "properties": {
        "task_id": {"$ref": "vehicle-lifecycle-common.schema.json#/$defs/maintenanceTaskId"},
        "task_key": {"$ref": "vehicle-lifecycle-common.schema.json#/$defs/canonicalKey"},
        "action": {"enum": ["INSPECT", "REPLACE", "ROTATE", "LUBRICATE", "CLEAN", "ADJUST", "TIGHTEN", "TEST", "OTHER"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 300},
        "system": {"$ref": "vehicle-lifecycle-common.schema.json#/$defs/systemRef"},
        "component_key": {"anyOf": [{"$ref": "vehicle-lifecycle-common.schema.json#/$defs/canonicalKey"}, {"type": "null"}]}
      }
    },
    "thresholds": {
      "type": "object", "additionalProperties": false,
      "required": ["distance", "elapsed_months", "engine_hours"],
      "properties": {
        "distance": {"anyOf": [{"$ref": "vehicle-lifecycle-common.schema.json#/$defs/odometer"}, {"type": "null"}]},
        "elapsed_months": {"type": ["integer", "null"], "minimum": 1, "maximum": 2400},
        "engine_hours": {"anyOf": [{"$ref": "vehicle-lifecycle-common.schema.json#/$defs/decimalString"}, {"type": "null"}]}
      }
    },
    "rule": {
      "type": "object", "additionalProperties": false,
      "required": ["rule_id", "rule_sha256", "schedule_policy", "initial_due", "recurrence", "baseline_policy"],
      "properties": {
        "rule_id": {"$ref": "vehicle-lifecycle-common.schema.json#/$defs/maintenanceRuleId"},
        "rule_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "schedule_policy": {"enum": ["WHICHEVER_OCCURS_FIRST", "ALL_THRESHOLDS", "ONE_TIME", "CONDITION_ONLY"]},
        "initial_due": {"$ref": "#/$defs/thresholds"},
        "recurrence": {"anyOf": [{"$ref": "#/$defs/thresholds"}, {"type": "null"}]},
        "baseline_policy": {"enum": ["VEHICLE_IN_SERVICE", "LAST_SATISFYING_COMPLETION", "MANUAL_VERIFIED_BASELINE", "NO_BASELINE"]}
      }
    },
    "predicate": {
      "type": "object", "additionalProperties": false,
      "required": ["configuration_key", "operator", "values"],
      "properties": {
        "configuration_key": {"$ref": "vehicle-lifecycle-common.schema.json#/$defs/canonicalKey"},
        "operator": {"enum": ["EQUALS", "NOT_EQUALS", "IN", "IS_YES", "IS_NO"]},
        "values": {"type": "array", "maxItems": 50, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}}
      }
    },
    "applicability": {
      "type": "object", "additionalProperties": false,
      "required": ["expression_language", "unknown_result", "predicates"],
      "properties": {
        "expression_language": {"const": "vhos-applicability-1"},
        "unknown_result": {"const": "BLOCKED"},
        "predicates": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/predicate"}}
      }
    }
  }
}
