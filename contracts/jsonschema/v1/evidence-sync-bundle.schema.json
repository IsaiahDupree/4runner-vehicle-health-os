{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vhos.dev/v1/evidence-sync-bundle.schema.json",
  "title": "VHOS Evidence Sync Bundle Manifest v1/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "contract_version", "bundle_id", "created_at", "creator", "segments"],
  "properties": {
    "contract": {"const": "vhos.evidence-sync-bundle"},
    "contract_version": {"enum": ["1.0.0", "2.0.0"]},
    "bundle_id": {"type": "string", "format": "uuid"},
    "created_at": {"$ref": "common.schema.json#/$defs/wallTime"},
    "creator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "application_id", "application_version", "device_model"],
      "properties": {
        "platform": {"type": "string", "enum": ["ANDROID", "IOS"]},
        "application_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "application_version": {"type": "string", "minLength": 1, "maxLength": 80},
        "device_model": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "media_type", "sha256", "byte_count", "record_count"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
            "maxLength": 256
          },
          "media_type": {"const": "application/x-ndjson"},
          "sha256": {"$ref": "common.schema.json#/$defs/sha256"},
          "byte_count": {"type": "integer", "minimum": 0, "maximum": 16777216},
          "record_count": {"type": "integer", "minimum": 0, "maximum": 20000}
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "vehicle_claims_authorized", "source_ledger_sha256"],
      "properties": {
        "classification": {"const": "RECOVERED_PORTABLE_EVIDENCE"},
        "vehicle_claims_authorized": {"const": false},
        "source_ledger_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"contract_version": {"const": "1.0.0"}}},
      "then": {"not": {"required": ["recovery"]}}
    },
    {
      "if": {"properties": {"contract_version": {"const": "2.0.0"}}},
      "then": {
        "required": ["recovery"],
        "properties": {
          "segments": {
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "properties": {
                "path": {"const": "segments/logical-frames.ndjson"}
              }
            }
          }
        }
      }
    }
  ]
}
