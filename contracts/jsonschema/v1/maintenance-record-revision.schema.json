{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vhos.dev/v1/maintenance-record-revision.schema.json",
  "title": "VHOS immutable maintenance record revision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "contract_version", "record_id", "revision_id", "supersedes_revision_id",
    "vehicle_id", "vehicle_asset_revision_id", "state", "event_type", "title", "occurrence",
    "odometer", "engine_hours", "systems", "components", "provider", "total_cost", "line_items",
    "measurements", "warranty", "notes", "custom_fields", "attachments", "completion_references",
    "actor", "created_at", "amendment_reason"
  ],
  "properties": {
    "contract": {"const": "vehicle.maintenance-record"},
    "contract_version": {"const": "1.0.0"},
    "record_id": {"$ref": "vehicle-lifecycle-common.schema.json#/$defs/maintenanceRecordId"},
    "revision_id": {"$ref": "vehicle-lifecycle-common.schema.json#/$defs/maintenanceRevisionId"},
    "supersedes_revision_id": {"anyOf": [{"$ref": "vehicle-lifecycle-common.schema.json#/$defs/maintenanceRevisionId"}, {"type": "null"}]},
    "vehicle_id": {"$ref": "vehicle-lifecycle-common.schema.json#/$defs/vehicleId"},
    "vehicle_asset_revision_id": {"$ref": "vehicle-lifecycle-common.schema.json#/$defs/vehicleRevisionId"},
    "state": {"enum": ["ACTIVE", "VOIDED"]},
    "event_type": {"enum": ["SERVICE", "REPAIR", "INSPECTION", "REPLACEMENT", "FLUID_SERVICE", "INSTALLATION", "REMOVAL", "ADJUSTMENT", "DIAGNOSTIC", "OTHER"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 300},
    "occurrence": {"$ref": "vehicle-lifecycle-common.schema.json#/$defs/occurrence"},
    "odometer": {"anyOf": [{"$ref": "vehicle-lifecycle-common.schema.json#/$defs/odometer"}, {"type": "null"}]},
    "engine_hours": {"anyOf": [{"$ref": "vehicle-lifecycle-common.schema.json#/$defs/decimalString"}, {"type": "null"}]},
    "systems": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "vehicle-lifecycle-common.schema.json#/$defs/systemRef"}},
    "components": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "vehicle-lifecycle-common.schema.json#/$defs/componentRef"}},
    "provider": {"anyOf": [{"$ref": "#/$defs/provider"}, {"type": "null"}]},
    "total_cost": {"anyOf": [{"$ref": "vehicle-lifecycle-common.schema.json#/$defs/money"}, {"type": "null"}]},
    "line_items": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/line_item"}},
    "measurements": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/measurement"}},
    "warranty": {"anyOf": [{"$ref": "#/$defs/warranty"}, {"type": "null"}]},
    "notes": {"type": ["string", "null"], "minLength": 1, "maxLength": 50000},
    "custom_fields": {"type": "array", "maxItems": 500, "items": {"$ref": "vehicle-lifecycle-common.schema.json#/$defs/customField"}},
    "attachments": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/attachment"}},
    "completion_references": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/completion_reference"}},
    "actor": {"$ref": "vehicle-lifecycle-common.schema.json#/$defs/actor"},
    "created_at": {"$ref": "common.schema.json#/$defs/wallTime"},
    "amendment_reason": {"type": ["string", "null"], "minLength": 1, "maxLength": 2000}
  },
  "$defs": {
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "phone", "email", "address", "invoice_number"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 240},
        "phone": {"type": ["string", "null"], "minLength": 1, "maxLength": 80},
        "email": {"type": ["string", "null"], "format": "email", "maxLength": 254},
        "address": {"type": ["string", "null"], "minLength": 1, "maxLength": 1000},
        "invoice_number": {"type": ["string", "null"], "minLength": 1, "maxLength": 160}
      }
    },
    "line_item": {
      "type": "object", "additionalProperties": false,
      "required": ["line_item_id", "type", "description", "manufacturer", "part_number", "specification", "quantity", "quantity_unit", "cost"],
      "properties": {
        "line_item_id": {"$ref": "vehicle-lifecycle-common.schema.json#/$defs/lineItemId"},
        "type": {"enum": ["PART", "FLUID", "SUPPLY", "LABOR", "OTHER"]},
        "description": {"type": "string", "minLength": 1, "maxLength": 500},
        "manufacturer": {"type": ["string", "null"], "minLength": 1, "maxLength": 200},
        "part_number": {"type": ["string", "null"], "minLength": 1, "maxLength": 200},
        "specification": {"type": ["string", "null"], "minLength": 1, "maxLength": 500},
        "quantity": {"$ref": "vehicle-lifecycle-common.schema.json#/$defs/decimalString"},
        "quantity_unit": {"type": "string", "minLength": 1, "maxLength": 80},
        "cost": {"anyOf": [{"$ref": "vehicle-lifecycle-common.schema.json#/$defs/money"}, {"type": "null"}]}
      }
    },
    "measurement": {
      "type": "object", "additionalProperties": false,
      "required": ["measurement_id", "name", "value_type", "value", "unit", "method", "condition_grade"],
      "properties": {
        "measurement_id": {"$ref": "vehicle-lifecycle-common.schema.json#/$defs/measurementId"},
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "value_type": {"enum": ["DECIMAL", "TEXT", "BOOLEAN"]},
        "value": {"type": "string", "minLength": 1, "maxLength": 1000},
        "unit": {"type": ["string", "null"], "minLength": 1, "maxLength": 80},
        "method": {"type": ["string", "null"], "minLength": 1, "maxLength": 500},
        "condition_grade": {"type": ["string", "null"], "minLength": 1, "maxLength": 120}
      },
      "allOf": [
        {"if": {"properties": {"value_type": {"const": "DECIMAL"}}, "required": ["value_type"]}, "then": {"properties": {"value": {"$ref": "vehicle-lifecycle-common.schema.json#/$defs/decimalString"}, "unit": {"type": "string", "minLength": 1}}}},
        {"if": {"properties": {"value_type": {"const": "BOOLEAN"}}, "required": ["value_type"]}, "then": {"properties": {"value": {"enum": ["true", "false"]}}}}
      ]
    },
    "warranty": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "starts_on", "expires_on", "distance_limit", "terms", "document_attachment_ids"],
      "properties": {
        "provider": {"type": "string", "minLength": 1, "maxLength": 240},
        "starts_on": {"type": "string", "format": "date"},
        "expires_on": {"type": ["string", "null"], "format": "date"},
        "distance_limit": {"anyOf": [{"$ref": "vehicle-lifecycle-common.schema.json#/$defs/odometer"}, {"type": "null"}]},
        "terms": {"type": ["string", "null"], "minLength": 1, "maxLength": 10000},
        "document_attachment_ids": {"type": "array", "maxItems": 50, "uniqueItems": true, "items": {"$ref": "vehicle-lifecycle-common.schema.json#/$defs/attachmentId"}}
      }
    },
    "attachment": {
      "type": "object", "additionalProperties": false,
      "required": ["attachment_id", "display_name", "media_type", "byte_count", "sha256", "storage_key", "availability", "captured_at"],
      "properties": {
        "attachment_id": {"$ref": "vehicle-lifecycle-common.schema.json#/$defs/attachmentId"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 255},
        "media_type": {"type": "string", "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$"},
        "byte_count": {"type": "integer", "minimum": 0, "maximum": 1073741824},
        "sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "storage_key": {"type": "string", "minLength": 1, "maxLength": 500},
        "availability": {"enum": ["AVAILABLE", "MISSING"]},
        "captured_at": {"anyOf": [{"$ref": "common.schema.json#/$defs/wallTime"}, {"type": "null"}]}
      }
    },
    "completion_reference": {
      "type": "object", "additionalProperties": false,
      "required": ["requirement_id", "requirement_version", "vehicle_pack_id", "vehicle_pack_version", "source_manifest_sha256", "task_id", "rule_id", "rule_sha256", "completion_role", "due_instance_id", "baseline_id", "effect"],
      "properties": {
        "requirement_id": {"$ref": "vehicle-lifecycle-common.schema.json#/$defs/requirementId"},
        "requirement_version": {"$ref": "common.schema.json#/$defs/semanticVersion"},
        "vehicle_pack_id": {"$ref": "vehicle-lifecycle-common.schema.json#/$defs/canonicalKey"},
        "vehicle_pack_version": {"$ref": "common.schema.json#/$defs/semanticVersion"},
        "source_manifest_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "task_id": {"$ref": "vehicle-lifecycle-common.schema.json#/$defs/maintenanceTaskId"},
        "rule_id": {"$ref": "vehicle-lifecycle-common.schema.json#/$defs/maintenanceRuleId"},
        "rule_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "completion_role": {"enum": ["DUE_INSTANCE", "BASELINE_ESTABLISHMENT", "DUE_AND_BASELINE", "NON_COMPLETION"]},
        "due_instance_id": {"anyOf": [{"$ref": "vehicle-lifecycle-common.schema.json#/$defs/maintenanceDueId"}, {"type": "null"}]},
        "baseline_id": {"anyOf": [{"$ref": "vehicle-lifecycle-common.schema.json#/$defs/maintenanceBaselineId"}, {"type": "null"}]},
        "effect": {"enum": ["SATISFIES_REQUIREMENT", "RESETS_BASELINE", "INSPECTION_ONLY", "DOES_NOT_SATISFY", "UNKNOWN"]}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"supersedes_revision_id": {"type": "null"}}, "required": ["supersedes_revision_id"]}, "then": {"properties": {"state": {"const": "ACTIVE"}, "amendment_reason": {"type": "null"}}}},
    {"if": {"properties": {"supersedes_revision_id": {"type": "string"}}, "required": ["supersedes_revision_id"]}, "then": {"properties": {"amendment_reason": {"type": "string", "minLength": 1}}}},
    {"if": {"properties": {"state": {"const": "VOIDED"}}, "required": ["state"]}, "then": {"properties": {"supersedes_revision_id": {"$ref": "vehicle-lifecycle-common.schema.json#/$defs/maintenanceRevisionId"}, "amendment_reason": {"type": "string", "minLength": 1}}}}
  ]
}
