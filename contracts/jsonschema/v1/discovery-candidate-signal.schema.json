{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vhos.dev/v1/discovery-candidate-signal.schema.json",
  "title": "VHOS Discovery candidate signal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "contract_version", "id", "created_at", "candidate_semantic", "field", "metrics", "review_state", "capture_ids", "test_template_ids", "event_marker_ids", "independent_evidence_references", "source_references", "authority"],
  "properties": {
    "contract": {"const": "vhos.discovery.candidate-signal"},
    "contract_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^candidate_[0-9A-HJKMNP-TV-Z]{26}$"},
    "created_at": {"$ref": "common.schema.json#/$defs/wallTime"},
    "candidate_semantic": {"$ref": "common.schema.json#/$defs/semanticId"},
    "proposed_canonical_signal_id": {"$ref": "common.schema.json#/$defs/semanticId"},
    "field": {"$ref": "discovery-common.schema.json#/$defs/candidateField"},
    "metrics": {"$ref": "discovery-common.schema.json#/$defs/candidateMetrics"},
    "review_state": {"type": "string", "enum": ["VERY_STRONG", "LIKELY", "NEEDS_MORE_DATA", "CONFLICTING", "REJECTED"]},
    "capture_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/captureId"}},
    "test_template_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/semanticId"}},
    "event_marker_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^marker_[0-9A-HJKMNP-TV-Z]{26}$"}},
    "independent_evidence_references": {"type": "array", "uniqueItems": true, "items": {"$ref": "discovery-common.schema.json#/$defs/evidenceReference"}},
    "source_references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "discovery-common.schema.json#/$defs/evidenceReference"}},
    "authority": {"const": "EXPERIMENTAL_CANDIDATE"}
  }
}
