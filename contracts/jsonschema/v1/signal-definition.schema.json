{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vhos.dev/v1/signal-definition.schema.json",
  "title": "Signal Definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "contract_version",
    "signal_id",
    "registry_version",
    "source",
    "raw_layout",
    "transform",
    "canonical_unit",
    "plausible_range",
    "cadence",
    "applicability",
    "validation_status",
    "provenance"
  ],
  "properties": {
    "contract": {"const": "signal.definition"},
    "contract_version": {"const": "1.0.0"},
    "signal_id": {"$ref": "common.schema.json#/$defs/semanticId"},
    "registry_version": {"$ref": "common.schema.json#/$defs/semanticVersion"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_id"],
      "properties": {
        "kind": {"type": "string", "enum": ["CAN_FRAME", "DIAGNOSTIC_RESPONSE", "ADDED_SENSOR", "SIMULATOR"]},
        "source_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "ecu_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "request_allowlist_entry_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "arbitration_id": {"type": "integer", "minimum": 0, "maximum": 536870911}
      }
    },
    "raw_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "byte_offset", "byte_length", "endianness", "signed"],
      "properties": {
        "encoding": {"type": "string", "enum": ["INTEGER", "IEEE754", "BIT_FIELD"]},
        "byte_offset": {"type": "integer", "minimum": 0},
        "byte_length": {"type": "integer", "minimum": 1, "maximum": 8},
        "bit_offset": {"type": "integer", "minimum": 0, "maximum": 63},
        "bit_length": {"type": "integer", "minimum": 1, "maximum": 64},
        "endianness": {"type": "string", "enum": ["BIG", "LITTLE"]},
        "signed": {"type": "boolean"}
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "ast"],
      "properties": {
        "language": {"const": "vhos-expression-1"},
        "ast": {"$ref": "equation-definition.schema.json#/$defs/expressionNode"}
      }
    },
    "canonical_unit": {"$ref": "common.schema.json#/$defs/unit"},
    "plausible_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": {"type": "number"},
        "maximum": {"type": "number"}
      }
    },
    "cadence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_period_ms", "stale_after_ms"],
      "properties": {
        "expected_period_ms": {"type": "integer", "minimum": 1},
        "stale_after_ms": {"type": "integer", "minimum": 1}
      }
    },
    "applicability": {
      "type": "object",
      "required": ["vehicle_config_pack", "conditions"],
      "properties": {
        "vehicle_config_pack": {"type": "string", "minLength": 1, "maxLength": 160},
        "conditions": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 300}}
      },
      "additionalProperties": false
    },
    "validation_status": {"$ref": "common.schema.json#/$defs/validationStatus"},
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "reference"],
        "properties": {
          "kind": {"type": "string", "enum": ["STANDARD", "OEM_SERVICE_INFORMATION", "TARGET_CAPTURE", "BENCH_MEASUREMENT", "SIMULATOR_SPEC"]},
          "reference": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    }
  }
}
