{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vhos.dev/v1/sensor-node-post.schema.json",
  "title": "A/C Sensor Node Power-On Self-Test v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "contract_version",
    "post_id",
    "device_id",
    "executed_at",
    "reset_reason",
    "identity",
    "configuration_crc32c",
    "state",
    "checks"
  ],
  "properties": {
    "contract": {"const": "sensor.node.post"},
    "contract_version": {"const": "1.0.0"},
    "post_id": {"$ref": "common.schema.json#/$defs/domainId"},
    "device_id": {"$ref": "common.schema.json#/$defs/domainId"},
    "executed_at": {"$ref": "common.schema.json#/$defs/wallTime"},
    "reset_reason": {"type": "string", "minLength": 1, "maxLength": 160},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hardware_revision", "firmware_version", "firmware_build_id", "device_config_revision"],
      "properties": {
        "hardware_revision": {"type": "string", "minLength": 1, "maxLength": 128},
        "firmware_version": {"$ref": "common.schema.json#/$defs/semanticVersion"},
        "firmware_build_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "device_config_revision": {"$ref": "common.schema.json#/$defs/semanticVersion"}
      }
    },
    "configuration_crc32c": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}$"
    },
    "state": {
      "type": "string",
      "enum": ["PASS", "DEGRADED", "SENSOR_FAULT", "POWER_FAULT", "STORAGE_FAULT", "SAFE_MODE"]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "status", "critical", "quality"],
        "properties": {
          "check_id": {"$ref": "common.schema.json#/$defs/semanticId"},
          "status": {"type": "string", "enum": ["PASS", "FAIL", "SKIPPED"]},
          "critical": {"type": "boolean"},
          "value": {"type": "number"},
          "unit": {"$ref": "common.schema.json#/$defs/unit"},
          "quality": {"$ref": "common.schema.json#/$defs/quality"},
          "detail": {"type": "string", "maxLength": 500}
        }
      }
    }
  }
}
