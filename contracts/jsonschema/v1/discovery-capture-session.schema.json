{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vhos.dev/v1/discovery-capture-session.schema.json",
  "title": "VHOS Discovery capture session v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "contract_version", "id", "vehicle_id", "vehicle_profile_sha256", "started_at", "ended_at", "wall_clock_basis", "start_monotonic_microseconds", "end_monotonic_microseconds", "gateway", "gateway_session_ids", "bus_bitrates_bps", "listen_only", "retained_record_count", "first_source_sequence", "last_source_sequence", "archive_sha256", "manifest_sha256", "event_markers", "physical_measurements", "notes", "authority"],
  "properties": {
    "contract": {"const": "vhos.discovery.capture-session"},
    "contract_version": {"const": "1.0.0"},
    "id": {"$ref": "common.schema.json#/$defs/captureId"},
    "vehicle_id": {"$ref": "common.schema.json#/$defs/vehicleId"},
    "vehicle_profile_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "started_at": {"$ref": "common.schema.json#/$defs/wallTime"},
    "ended_at": {"$ref": "common.schema.json#/$defs/wallTime"},
    "wall_clock_basis": {"type": "string", "enum": ["CAPTURE_EPOCH_SYNCHRONIZED", "EVIDENCE_INGESTION_TIME"]},
    "start_monotonic_microseconds": {"type": "integer", "minimum": 0},
    "end_monotonic_microseconds": {"type": "integer", "minimum": 0},
    "gateway": {"$ref": "discovery-common.schema.json#/$defs/gatewayProvenance"},
    "gateway_session_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 4294967295}},
    "bus_bitrates_bps": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "enum": [250000, 500000]}},
    "listen_only": {"const": true},
    "retained_record_count": {"type": "integer", "minimum": 1},
    "first_source_sequence": {"type": "integer", "minimum": 1},
    "last_source_sequence": {"type": "integer", "minimum": 1},
    "archive_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "manifest_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "test_template_id": {"$ref": "common.schema.json#/$defs/semanticId"},
    "test_template_version": {"$ref": "common.schema.json#/$defs/semanticVersion"},
    "event_markers": {"type": "array", "uniqueItems": true, "items": {"$ref": "discovery-common.schema.json#/$defs/eventMarker"}},
    "physical_measurements": {"type": "array", "uniqueItems": true, "items": {"$ref": "discovery-common.schema.json#/$defs/physicalMeasurement"}},
    "notes": {"type": "string", "maxLength": 2000},
    "authority": {"const": "OBSERVED"}
  },
  "dependentRequired": {"test_template_id": ["test_template_version"], "test_template_version": ["test_template_id"]}
}
