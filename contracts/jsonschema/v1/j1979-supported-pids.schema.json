{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vhos.dev/v1/j1979-supported-pids.schema.json",
  "title": "VHOS SAE J1979 supported-PID enumeration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "contract_version", "gateway_id", "capture_id", "generated_at", "mode", "authority", "ecu_results"],
  "properties": {
    "contract": {"const": "obd.j1979-supported-pids"},
    "contract_version": {"const": "1.0.0"},
    "gateway_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
    "capture_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,160}$"},
    "generated_at": {"$ref": "common.schema.json#/$defs/wallTime"},
    "mode": {"const": 1},
    "authority": {"type": "string", "minLength": 1, "maxLength": 1000},
    "ecu_results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ecu_address", "transport", "enumeration_complete", "queried_base_pids", "supported_pids", "response_evidence"],
        "properties": {
          "ecu_address": {"type": "string", "pattern": "^0x[0-9A-F]{3,8}$"},
          "transport": {"type": "string", "minLength": 1, "maxLength": 40},
          "enumeration_complete": {"type": "boolean"},
          "incomplete_reason": {"type": ["string", "null"], "maxLength": 500},
          "queried_base_pids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {"type": "integer", "enum": [0, 32, 64, 96, 128, 160, 192, 224]}
          },
          "supported_pids": {
            "type": "array",
            "maxItems": 255,
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 1, "maximum": 255}
          },
          "response_evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["base_pid", "bitmap_hex", "response_payload_hex", "observed_at", "gateway_monotonic_microseconds", "source_sequence"],
              "properties": {
                "base_pid": {"type": "integer", "enum": [0, 32, 64, 96, 128, 160, 192, 224]},
                "bitmap_hex": {"type": "string", "pattern": "^[0-9A-F]{8}$"},
                "response_payload_hex": {"type": "string", "pattern": "^[0-9A-F]{12,510}$"},
                "observed_at": {"$ref": "common.schema.json#/$defs/wallTime"},
                "gateway_monotonic_microseconds": {"type": "integer", "minimum": 0},
                "source_sequence": {"type": "integer", "minimum": 0}
              }
            }
          }
        }
      }
    }
  }
}
