{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vhos.dev/v1/can-signal-hypothesis-pack.schema.json",
  "title": "CAN Signal Hypothesis Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "contract_version",
    "pack_id",
    "pack_version",
    "target",
    "authority",
    "sources",
    "hypotheses",
    "relationships"
  ],
  "properties": {
    "contract": {"const": "can.signal-hypothesis-pack"},
    "contract_version": {"const": "1.0.0"},
    "pack_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"},
    "pack_version": {"$ref": "common.schema.json#/$defs/semanticVersion"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["make", "model", "model_year", "vin_resolved"],
      "properties": {
        "make": {"type": "string", "minLength": 1, "maxLength": 80},
        "model": {"type": "string", "minLength": 1, "maxLength": 80},
        "model_year": {"type": "integer", "minimum": 1900, "maximum": 2200},
        "engine": {"type": ["string", "null"], "maxLength": 80},
        "drivetrain": {"type": ["string", "null"], "maxLength": 80},
        "vin_resolved": {"type": "boolean"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "accepted_signal_definitions",
        "production_value_display_allowed",
        "automatic_promotion_allowed",
        "statement"
      ],
      "properties": {
        "status": {"const": "DISCOVERY_ONLY"},
        "accepted_signal_definitions": {"const": 0},
        "production_value_display_allowed": {"const": false},
        "automatic_promotion_allowed": {"const": false},
        "statement": {"type": "string", "minLength": 20, "maxLength": 1000}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/hypothesis"}
    },
    "relationships": {
      "type": "array",
      "items": {"$ref": "#/$defs/relationship"}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "authority_level",
        "publisher",
        "url",
        "scope",
        "limitations"
      ],
      "properties": {
        "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"},
        "authority_level": {"type": "string", "enum": ["A", "B", "C"]},
        "publisher": {"type": "string", "minLength": 1, "maxLength": 160},
        "url": {"type": "string", "format": "uri", "maxLength": 1000},
        "revision": {"type": ["string", "null"], "maxLength": 160},
        "scope": {"type": "string", "minLength": 10, "maxLength": 1000},
        "limitations": {"type": "string", "minLength": 10, "maxLength": 1000}
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byte_offset",
        "byte_length",
        "endianness",
        "mask",
        "right_shift",
        "signed_bits"
      ],
      "properties": {
        "byte_offset": {"type": "integer", "minimum": 0, "maximum": 7},
        "byte_length": {"type": "integer", "minimum": 1, "maximum": 8},
        "endianness": {"type": "string", "enum": ["BIG", "LITTLE"]},
        "mask": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "right_shift": {"type": "integer", "minimum": 0, "maximum": 63},
        "signed_bits": {"type": ["integer", "null"], "minimum": 1, "maximum": 64}
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transform_id", "scale", "offset", "unit", "source_ids"],
      "properties": {
        "transform_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"},
        "scale": {"type": "number"},
        "offset": {"type": "number"},
        "unit": {"type": "string", "minLength": 1, "maxLength": 40},
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 160}
        },
        "note": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypothesis_id",
        "identifier",
        "identifier_hex",
        "extended",
        "candidate_semantic",
        "status",
        "field",
        "candidate_transforms",
        "source_ids",
        "production_value_display_allowed",
        "required_validation",
        "limitations"
      ],
      "properties": {
        "hypothesis_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"},
        "identifier": {"type": "integer", "minimum": 0, "maximum": 536870911},
        "identifier_hex": {"type": "string", "pattern": "^0x[0-9A-F]{3,8}$"},
        "extended": {"type": "boolean"},
        "candidate_semantic": {"type": ["string", "null"], "maxLength": 160},
        "status": {
          "type": "string",
          "enum": [
            "HIGH_PRIORITY_CROSS_MODEL_CANDIDATE",
            "CROSS_MODEL_CANDIDATE",
            "CORROBORATED_ID_ONLY",
            "UNMAPPED"
          ]
        },
        "field": {"oneOf": [{"$ref": "#/$defs/field"}, {"type": "null"}]},
        "candidate_transforms": {
          "type": "array",
          "items": {"$ref": "#/$defs/transform"}
        },
        "source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 160}
        },
        "production_value_display_allowed": {"const": false},
        "required_validation": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 5, "maxLength": 500}
        },
        "limitations": {"type": "string", "minLength": 10, "maxLength": 1000}
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationship_id",
        "left_hypothesis_id",
        "left_transform_id",
        "right_hypothesis_id",
        "right_transform_id",
        "maximum_pairing_delta_us",
        "interpretation",
        "production_value_display_allowed"
      ],
      "properties": {
        "relationship_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"},
        "left_hypothesis_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "left_transform_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "right_hypothesis_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "right_transform_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "maximum_pairing_delta_us": {"type": "integer", "minimum": 1, "maximum": 10000000},
        "interpretation": {"type": "string", "minLength": 10, "maxLength": 1000},
        "production_value_display_allowed": {"const": false}
      }
    }
  }
}
