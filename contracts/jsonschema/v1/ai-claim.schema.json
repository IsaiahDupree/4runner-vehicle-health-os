{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vhos.dev/v1/ai-claim.schema.json",
  "title": "Evidence-bound AI Claim v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "contract_version", "claim_id", "text", "claim_type", "evidence_refs", "confidence", "hypothesis", "authority"],
  "properties": {
    "contract": {"const": "ai.claim"},
    "contract_version": {"const": "1.0.0"},
    "claim_id": {"$ref": "common.schema.json#/$defs/claimId"},
    "text": {"type": "string", "minLength": 1, "maxLength": 4000},
    "claim_type": {"type": "string", "enum": ["VEHICLE_OBSERVATION_INTERPRETATION", "HYPOTHESIS", "GENERAL_GUIDANCE"]},
    "evidence_refs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/evidenceRef"}, "uniqueItems": true},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "hypothesis": {"type": "boolean"},
    "authority": {"const": "NON_AUTHORITATIVE"}
  },
  "allOf": [
    {
      "if": {"properties": {"claim_type": {"enum": ["VEHICLE_OBSERVATION_INTERPRETATION", "HYPOTHESIS"]}}},
      "then": {"properties": {"evidence_refs": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"claim_type": {"const": "HYPOTHESIS"}}},
      "then": {"properties": {"hypothesis": {"const": true}}}
    },
    {
      "if": {"properties": {"claim_type": {"const": "VEHICLE_OBSERVATION_INTERPRETATION"}}},
      "then": {"properties": {"hypothesis": {"const": false}}}
    }
  ]
}
