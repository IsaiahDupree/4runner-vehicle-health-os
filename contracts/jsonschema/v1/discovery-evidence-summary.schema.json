{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vhos.dev/v1/discovery-evidence-summary.schema.json",
  "title": "VHOS Discovery evidence summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "contract_version", "capture_id", "archive_sha256", "retained_record_count", "unique_identifier_count", "gateway_session_count", "start_monotonic_microseconds", "end_monotonic_microseconds", "first_source_sequence", "last_source_sequence", "unretained_source_sequence_position_count", "standard_frame_count", "extended_frame_count", "observed_bitrates_bps", "marker_count", "measurement_count", "authority"],
  "properties": {
    "contract": {"const": "vhos.discovery.evidence-summary"},
    "contract_version": {"const": "1.0.0"},
    "capture_id": {"$ref": "common.schema.json#/$defs/captureId"},
    "archive_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "retained_record_count": {"type": "integer", "minimum": 1},
    "unique_identifier_count": {"type": "integer", "minimum": 1},
    "gateway_session_count": {"type": "integer", "minimum": 1},
    "start_monotonic_microseconds": {"type": "integer", "minimum": 0},
    "end_monotonic_microseconds": {"type": "integer", "minimum": 0},
    "first_source_sequence": {"type": "integer", "minimum": 1},
    "last_source_sequence": {"type": "integer", "minimum": 1},
    "unretained_source_sequence_position_count": {"type": "integer", "minimum": 0},
    "standard_frame_count": {"type": "integer", "minimum": 0},
    "extended_frame_count": {"type": "integer", "minimum": 0},
    "observed_bitrates_bps": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "enum": [250000, 500000]}},
    "marker_count": {"type": "integer", "minimum": 0},
    "measurement_count": {"type": "integer", "minimum": 0},
    "authority": {"const": "OBSERVED"}
  }
}
