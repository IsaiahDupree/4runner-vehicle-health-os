{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vhos.dev/v1/mechanic-common.schema.json",
  "title": "VHOS commercial mechanic workflow common definitions v1",
  "$defs": {
    "caseId": {
      "type": "string",
      "pattern": "^case_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "caseRevisionId": {
      "type": "string",
      "pattern": "^caserev_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "organizationId": {
      "type": "string",
      "pattern": "^org_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "customerId": {
      "type": "string",
      "pattern": "^customer_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^evidence_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "hypothesisId": {
      "type": "string",
      "pattern": "^hypothesis_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "caseStatus": {
      "enum": [
        "INTAKE",
        "INSPECTION",
        "FINDINGS",
        "VERIFY",
        "CLOSED",
        "VOIDED"
      ]
    },
    "transitionAction": {
      "enum": [
        "CREATED",
        "AMENDED",
        "INSPECTION_STARTED",
        "FINDINGS_RECORDED",
        "VERIFICATION_STARTED",
        "CLOSED",
        "VOIDED"
      ]
    },
    "organizationSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization_id", "display_name"],
      "properties": {
        "organization_id": {"$ref": "#/$defs/organizationId"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    },
    "customerSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["customer_id", "display_name", "phone", "email"],
      "properties": {
        "customer_id": {"$ref": "#/$defs/customerId"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 160},
        "phone": {"type": ["string", "null"], "minLength": 1, "maxLength": 80},
        "email": {"type": ["string", "null"], "format": "email", "maxLength": 254}
      }
    },
    "vehicleSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vehicle_id",
        "display_name",
        "vin",
        "model_year",
        "make",
        "model",
        "trim",
        "license_plate",
        "odometer"
      ],
      "properties": {
        "vehicle_id": {
          "$ref": "vehicle-lifecycle-common.schema.json#/$defs/vehicleId"
        },
        "display_name": {"type": "string", "minLength": 1, "maxLength": 200},
        "vin": {
          "type": ["string", "null"],
          "pattern": "^[A-HJ-NPR-Z0-9]{17}$"
        },
        "model_year": {
          "type": ["integer", "null"],
          "minimum": 1886,
          "maximum": 3000
        },
        "make": {"type": ["string", "null"], "minLength": 1, "maxLength": 120},
        "model": {"type": ["string", "null"], "minLength": 1, "maxLength": 120},
        "trim": {"type": ["string", "null"], "minLength": 1, "maxLength": 120},
        "license_plate": {"type": ["string", "null"], "minLength": 1, "maxLength": 32},
        "odometer": {
          "anyOf": [
            {"$ref": "vehicle-lifecycle-common.schema.json#/$defs/odometer"},
            {"type": "null"}
          ]
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "from_status", "to_status", "reason"],
      "properties": {
        "action": {"$ref": "#/$defs/transitionAction"},
        "from_status": {
          "anyOf": [
            {"$ref": "#/$defs/caseStatus"},
            {"type": "null"}
          ]
        },
        "to_status": {"$ref": "#/$defs/caseStatus"},
        "reason": {"type": ["string", "null"], "minLength": 1, "maxLength": 2000}
      }
    },
    "complaint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "operating_conditions",
        "prior_work",
        "reported_by",
        "reported_at"
      ],
      "properties": {
        "description": {"type": "string", "minLength": 1, "maxLength": 10000},
        "operating_conditions": {"type": ["string", "null"], "minLength": 1, "maxLength": 5000},
        "prior_work": {"type": ["string", "null"], "minLength": 1, "maxLength": 5000},
        "reported_by": {"enum": ["CUSTOMER", "REFERRING_SHOP", "TECHNICIAN"]},
        "reported_at": {"$ref": "common.schema.json#/$defs/wallTime"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "type",
        "source",
        "quality",
        "description",
        "method",
        "test_point",
        "expected_result",
        "expected_result_source",
        "recorded_at",
        "value",
        "unit",
        "dtc_code",
        "attachment"
      ],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/evidenceId"},
        "type": {
          "enum": [
            "OBSERVATION",
            "MEASUREMENT",
            "DTC",
            "PHOTO",
            "VIDEO",
            "AUDIO",
            "DOCUMENT",
            "SCAN_REPORT"
          ]
        },
        "source": {
          "enum": [
            "CUSTOMER_ASSERTED",
            "REFERRING_SHOP_ASSERTED",
            "TECHNICIAN_OBSERVED",
            "TECHNICIAN_MEASURED",
            "IMPORTED",
            "VEHICLE_GATEWAY"
          ]
        },
        "quality": {"enum": ["UNVERIFIED", "VERIFIED", "STALE", "INVALID"]},
        "description": {"type": "string", "minLength": 1, "maxLength": 10000},
        "method": {"type": ["string", "null"], "minLength": 1, "maxLength": 5000},
        "test_point": {"type": ["string", "null"], "minLength": 1, "maxLength": 1000},
        "expected_result": {"type": ["string", "null"], "minLength": 1, "maxLength": 2000},
        "expected_result_source": {"type": ["string", "null"], "minLength": 1, "maxLength": 2000},
        "recorded_at": {"$ref": "common.schema.json#/$defs/wallTime"},
        "value": {
          "anyOf": [
            {"$ref": "vehicle-lifecycle-common.schema.json#/$defs/decimalString"},
            {"type": "null"}
          ]
        },
        "unit": {"type": ["string", "null"], "minLength": 1, "maxLength": 80},
        "dtc_code": {
          "type": ["string", "null"],
          "pattern": "^[PBCU][0-3][0-9A-F]{3}$"
        },
        "attachment": {
          "anyOf": [
            {"$ref": "maintenance-record-revision.schema.json#/$defs/attachment"},
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "MEASUREMENT"}}, "required": ["type"]},
          "then": {
            "properties": {
              "value": {"$ref": "vehicle-lifecycle-common.schema.json#/$defs/decimalString"},
              "unit": {"type": "string", "minLength": 1},
              "method": {"type": "string", "minLength": 1},
              "dtc_code": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "DTC"}}, "required": ["type"]},
          "then": {
            "properties": {
              "value": {"type": "null"},
              "unit": {"type": "null"},
              "dtc_code": {"type": "string", "pattern": "^[PBCU][0-3][0-9A-F]{3}$"}
            }
          },
          "else": {"properties": {"dtc_code": {"type": "null"}}}
        },
        {
          "if": {
            "properties": {
              "type": {"enum": ["PHOTO", "VIDEO", "AUDIO", "DOCUMENT", "SCAN_REPORT"]}
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "attachment": {
                "$ref": "maintenance-record-revision.schema.json#/$defs/attachment"
              }
            }
          }
        },
        {
          "if": {"properties": {"value": {"type": "string"}}, "required": ["value"]},
          "then": {"properties": {"unit": {"type": "string", "minLength": 1}}}
        },
        {
          "if": {"properties": {"unit": {"type": "string"}}, "required": ["unit"]},
          "then": {
            "properties": {
              "value": {"$ref": "vehicle-lifecycle-common.schema.json#/$defs/decimalString"}
            }
          }
        }
      ]
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hypothesis_id", "statement", "evidence_links"],
      "properties": {
        "hypothesis_id": {"$ref": "#/$defs/hypothesisId"},
        "statement": {"type": "string", "minLength": 1, "maxLength": 2000},
        "evidence_links": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["evidence_id", "relationship"],
            "properties": {
              "evidence_id": {"$ref": "#/$defs/evidenceId"},
              "relationship": {"enum": ["SUPPORTS", "CONTRADICTS", "UNKNOWN"]}
            }
          }
        }
      }
    },
    "technicianFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conclusion", "limitations", "next_action", "actor", "recorded_at"],
      "properties": {
        "conclusion": {"type": "string", "minLength": 1, "maxLength": 10000},
        "limitations": {
          "type": "array",
          "maxItems": 100,
          "items": {"type": "string", "minLength": 1, "maxLength": 2000}
        },
        "next_action": {"type": "string", "minLength": 1, "maxLength": 5000},
        "actor": {
          "allOf": [
            {"$ref": "vehicle-lifecycle-common.schema.json#/$defs/actor"},
            {"properties": {"source": {"const": "TECHNICIAN"}}}
          ]
        },
        "recorded_at": {"$ref": "common.schema.json#/$defs/wallTime"}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "method", "reason", "evidence_ids", "recorded_at"],
      "properties": {
        "outcome": {
          "enum": ["RESOLVED", "NOT_RESOLVED", "NOT_REPRODUCED", "NOT_PERFORMED"]
        },
        "method": {"type": ["string", "null"], "minLength": 1, "maxLength": 2000},
        "reason": {"type": ["string", "null"], "minLength": 1, "maxLength": 2000},
        "evidence_ids": {
          "type": "array",
          "maxItems": 500,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/evidenceId"}
        },
        "recorded_at": {"$ref": "common.schema.json#/$defs/wallTime"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"outcome": {"const": "NOT_PERFORMED"}},
            "required": ["outcome"]
          },
          "then": {
            "properties": {
              "method": {"type": "null"},
              "reason": {"type": "string", "minLength": 1},
              "evidence_ids": {"maxItems": 0}
            }
          },
          "else": {
            "properties": {
              "method": {"type": "string", "minLength": 1},
              "evidence_ids": {"minItems": 1}
            }
          }
        }
      ]
    }
  }
}
