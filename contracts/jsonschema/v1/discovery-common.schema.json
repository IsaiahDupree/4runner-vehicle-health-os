{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vhos.dev/v1/discovery-common.schema.json",
  "title": "VHOS Discovery common definitions v1",
  "$defs": {
    "authority": {
      "type": "string",
      "enum": ["OBSERVED", "EXPERIMENTAL_CANDIDATE", "VEHICLE_VALIDATED", "DEFINITION_VALIDATED", "PROMOTED"]
    },
    "discoveryProtocol": {
      "type": "string",
      "enum": ["CAN_11_500", "CAN_29_500", "CAN_11_250", "CAN_29_250", "ISO_9141_2", "ISO_14230_FAST", "ISO_14230_SLOW", "J1850_PWM", "J1850_VPW"]
    },
    "evidenceReference": {"type": "string", "minLength": 1, "maxLength": 240},
    "gatewayProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateway_id"],
      "properties": {
        "gateway_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "hardware_revision": {"type": "string", "minLength": 1, "maxLength": 160},
        "firmware_version": {"type": "string", "minLength": 1, "maxLength": 160},
        "firmware_build_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "protocol_version": {"type": "string", "minLength": 1, "maxLength": 160},
        "active_config_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "active_config_version": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    },
    "markerKind": {
      "type": "string",
      "enum": ["IGNITION_ON", "IGNITION_OFF", "ENGINE_STARTED", "BRAKE_PRESSED", "BRAKE_RELEASED", "ACCELERATOR_CHANGED", "STEERING_CHANGED", "AC_ON", "AC_OFF", "COMPRESSOR_OBSERVED_ON", "COMPRESSOR_OBSERVED_OFF", "MEASUREMENT_TAKEN", "NOISE_OBSERVED", "CUSTOM"]
    },
    "evidenceSource": {
      "type": "string",
      "enum": ["USER", "IPHONE", "ANDROID_HEAD_UNIT", "GATEWAY", "SCAN_TOOL", "EXTERNAL_INSTRUMENT", "ADDED_SENSOR"]
    },
    "eventMarker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "contract_version", "id", "capture_id", "gateway_monotonic_microseconds", "recorded_at", "kind", "label", "source", "note", "authority"],
      "properties": {
        "contract": {"const": "vhos.discovery.event-marker"},
        "contract_version": {"const": "1.0.0"},
        "id": {"type": "string", "pattern": "^marker_[0-9A-HJKMNP-TV-Z]{26}$"},
        "capture_id": {"$ref": "common.schema.json#/$defs/captureId"},
        "gateway_session_id": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "gateway_monotonic_microseconds": {"type": "integer", "minimum": 0},
        "recorded_at": {"$ref": "common.schema.json#/$defs/wallTime"},
        "kind": {"$ref": "#/$defs/markerKind"},
        "label": {"type": "string", "minLength": 1, "maxLength": 160},
        "source": {"$ref": "#/$defs/evidenceSource"},
        "observer_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "nearest_can_sequence": {"type": "integer", "minimum": 0},
        "note": {"type": "string", "maxLength": 1000},
        "authority": {"const": "OBSERVED"}
      }
    },
    "physicalMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "contract_version", "id", "capture_id", "gateway_monotonic_microseconds", "recorded_at", "signal_id", "value", "unit", "method", "source", "quality", "note", "authority"],
      "properties": {
        "contract": {"const": "vhos.discovery.physical-measurement"},
        "contract_version": {"const": "1.0.0"},
        "id": {"type": "string", "pattern": "^measurement_[0-9A-HJKMNP-TV-Z]{26}$"},
        "capture_id": {"$ref": "common.schema.json#/$defs/captureId"},
        "gateway_session_id": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "gateway_monotonic_microseconds": {"type": "integer", "minimum": 0},
        "recorded_at": {"$ref": "common.schema.json#/$defs/wallTime"},
        "signal_id": {"$ref": "common.schema.json#/$defs/semanticId"},
        "value": {"type": "number"},
        "unit": {"$ref": "common.schema.json#/$defs/unit"},
        "method": {"type": "string", "minLength": 1, "maxLength": 240},
        "instrument_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "calibration_reference": {"$ref": "#/$defs/evidenceReference"},
        "source": {"$ref": "#/$defs/evidenceSource"},
        "quality": {"type": "string", "enum": ["GOOD", "MANUALLY_ENTERED", "INSTRUMENT_UNVERIFIED", "CALIBRATION_EXPIRED", "UNCERTAIN"]},
        "nearest_can_sequence": {"type": "integer", "minimum": 0},
        "note": {"type": "string", "maxLength": 1000},
        "authority": {"const": "OBSERVED"}
      }
    },
    "passiveBusCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocols", "retained_record_count", "unique_identifier_count", "observed_bitrates_bps", "standard_frame_count", "extended_frame_count", "evidence_sha256"],
      "properties": {
        "protocols": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/discoveryProtocol"}},
        "retained_record_count": {"type": "integer", "minimum": 1},
        "unique_identifier_count": {"type": "integer", "minimum": 1},
        "observed_bitrates_bps": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "enum": [250000, 500000]}},
        "standard_frame_count": {"type": "integer", "minimum": 0},
        "extended_frame_count": {"type": "integer", "minimum": 0},
        "evidence_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "candidateField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_id", "identifier", "extended", "byte_offset", "bit_offset", "bit_length", "byte_order", "signed"],
      "properties": {
        "protocol_id": {"type": "string", "enum": ["CAN_11_500", "CAN_29_500", "CAN_11_250", "CAN_29_250"]},
        "identifier": {"type": "integer", "minimum": 0, "maximum": 536870911},
        "extended": {"type": "boolean"},
        "byte_offset": {"type": "integer", "minimum": 0, "maximum": 7},
        "bit_offset": {"type": "integer", "minimum": 0, "maximum": 7},
        "bit_length": {"type": "integer", "minimum": 1, "maximum": 64},
        "byte_order": {"type": "string", "enum": ["BIG_ENDIAN", "LITTLE_ENDIAN"]},
        "signed": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"protocol_id": {"enum": ["CAN_11_500", "CAN_11_250"]}}, "required": ["protocol_id"]},
          "then": {"properties": {"extended": {"const": false}}}
        },
        {
          "if": {"properties": {"protocol_id": {"enum": ["CAN_29_500", "CAN_29_250"]}}, "required": ["protocol_id"]},
          "then": {"properties": {"extended": {"const": true}}}
        }
      ]
    },
    "candidateMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["false_activation_count", "analyzed_observation_count", "analyzed_capture_count", "controlled_test_count", "behavior_shape", "algorithm_id", "algorithm_version"],
      "properties": {
        "correlation": {"type": "number", "minimum": -1, "maximum": 1},
        "repeatability": {"type": "number", "minimum": 0, "maximum": 1},
        "false_activation_count": {"type": "integer", "minimum": 0},
        "analyzed_observation_count": {"type": "integer", "minimum": 1},
        "analyzed_capture_count": {"type": "integer", "minimum": 1},
        "controlled_test_count": {"type": "integer", "minimum": 0},
        "behavior_shape": {"type": "string", "enum": ["BOOLEAN", "ANALOG", "COUNTER", "STATE_CODE", "TEMPERATURE_SHAPED", "UNKNOWN"]},
        "algorithm_id": {"$ref": "common.schema.json#/$defs/semanticId"},
        "algorithm_version": {"$ref": "common.schema.json#/$defs/semanticVersion"}
      }
    },
    "validationRequirement": {
      "type": "string",
      "enum": ["SIGNAL_DEFINITION", "SOURCE_DEFINED", "DECODER_DEFINED", "TYPE_AND_UNIT_DEFINED", "PLAUSIBLE_RANGE_DEFINED", "FRESHNESS_DEFINED", "VEHICLE_APPLICABILITY_RESOLVED", "TARGET_VEHICLE_CAPTURE", "REPEATABILITY_ACROSS_CONTROLLED_TESTS", "INDEPENDENT_CORROBORATION", "GOLDEN_REPLAY", "STALE_BEHAVIOR_DEFINED", "MISSING_BEHAVIOR_DEFINED", "OUT_OF_RANGE_BEHAVIOR_DEFINED", "PROVENANCE_PRESERVED", "CONTRADICTIONS_PRESERVED", "APPROVAL_REVIEWER_RECORDED"]
    },
    "validationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement", "status", "evidence_references", "rationale"],
      "properties": {
        "requirement": {"$ref": "#/$defs/validationRequirement"},
        "status": {"type": "string", "enum": ["SATISFIED", "MISSING", "CONFLICTING", "NOT_APPLICABLE"]},
        "evidence_references": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceReference"}},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 1000}
      },
      "allOf": [{"if": {"properties": {"status": {"const": "SATISFIED"}}}, "then": {"properties": {"evidence_references": {"minItems": 1}}}}]
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "reviewed_at", "decision", "evidence_reference", "note", "authority"],
      "properties": {
        "reviewer_id": {"type": "string", "pattern": "^reviewer_[0-9A-HJKMNP-TV-Z]{26}$"},
        "reviewed_at": {"$ref": "common.schema.json#/$defs/wallTime"},
        "decision": {"type": "string", "enum": ["APPROVE", "REJECT", "REQUEST_MORE_EVIDENCE"]},
        "evidence_reference": {"$ref": "#/$defs/evidenceReference"},
        "note": {"type": "string", "minLength": 1, "maxLength": 1000},
        "authority": {"const": "OBSERVED"}
      }
    },
    "testStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sequence", "instruction", "requires_explicit_confirmation"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/semanticId"},
        "sequence": {"type": "integer", "minimum": 1},
        "instruction": {"type": "string", "minLength": 1, "maxLength": 500},
        "suggested_duration_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "expected_marker_kind": {"$ref": "#/$defs/markerKind"},
        "requires_explicit_confirmation": {"type": "boolean"}
      }
    }
  }
}
